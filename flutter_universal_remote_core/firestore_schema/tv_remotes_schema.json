{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FirestoreUniversalTvRemoteDatabaseSchema",
  "description": "Firestore document collection architecture for Global & Indian TV IR Hex codes, Bluetooth protocols, and Wi-Fi commands.",
  "collections": {
    "tv_brands": {
      "document_id": "{brand_id} (e.g. marq, onida, onida_smart, oneplus, realme, kodak, croma, videocon, intex, sansui, daiwa, vu, mi, thomson, micromax, lloyd, bpl, sanyo, samsung, lg, sony, hisense, philips, panasonic, tcl, haier, toshiba, sharp)",
      "fields": {
        "id": "string",
        "name": "string",
        "category": "string ('global' | 'indian_local')",
        "country": "string",
        "popularity_rank": "number",
        "supported_protocols": "array<string> ('IR', 'BLE', 'WIFI_TIZEN', 'WIFI_WEBOS', 'WIFI_BRAVIA', 'WIFI_ANDROID_TV')",
        "default_carrier_frequency": "number (e.g. 38000)",
        "models_count": "number",
        "logo_asset": "string"
      },
      "subcollections": {
        "remote_profiles": {
          "document_id": "{profile_id} (e.g. nec_profile_1, smart_ble_v2, legacy_rc5)",
          "fields": {
            "profile_name": "string",
            "protocol_type": "string ('NEC' | 'RC5' | 'SONY_SIRC' | 'BLE_GATT' | 'WIFI_REST')",
            "carrier_frequency": "number",
            "layout_type": "string ('smart_modern' | 'classic_dth' | 'minimalist_ott')",
            "applicable_models": "array<string>",
            "keys": {
              "power": { "label": "Power", "nec_hex": "string", "pronto_hex": "string" },
              "mute": { "label": "Mute", "nec_hex": "string" },
              "vol_up": { "label": "Vol +", "nec_hex": "string" },
              "vol_down": { "label": "Vol -", "nec_hex": "string" },
              "ch_up": { "label": "CH +", "nec_hex": "string" },
              "ch_down": { "label": "CH -", "nec_hex": "string" },
              "source_input": { "label": "Source", "nec_hex": "string" },
              "dpad_up": { "label": "Up", "nec_hex": "string" },
              "dpad_down": { "label": "Down", "nec_hex": "string" },
              "dpad_left": { "label": "Left", "nec_hex": "string" },
              "dpad_right": { "label": "Right", "nec_hex": "string" },
              "dpad_ok": { "label": "Select", "nec_hex": "string" },
              "home": { "label": "Home", "nec_hex": "string" },
              "back": { "label": "Back", "nec_hex": "string" },
              "menu": { "label": "Menu", "nec_hex": "string" },
              "netflix": { "label": "Netflix", "nec_hex": "string" },
              "prime_video": { "label": "Prime Video", "nec_hex": "string" },
              "youtube": { "label": "YouTube", "nec_hex": "string" },
              "hotstar": { "label": "Disney+ Hotstar", "nec_hex": "string" }
            }
          }
        }
      }
    }
  },
